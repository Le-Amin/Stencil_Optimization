#!/bin/bash
# Étude de passage à l'échelle (strong scaling) OpenMP sur ROMEO.
# Soumission :   sbatch scaling.job        (résultats dans scaling.out)

#SBATCH --nodes 1
#SBATCH --ntasks-per-node 1
#SBATCH --job-name stencil-scaling
#SBATCH --time 00:30:00
#SBATCH --output scaling.out
#SBATCH --exclusive
##SBATCH --partition <partition>
##SBATCH --account <projet>

# module load gcc

set -e
make clean >/dev/null
make stencil

NCPUS=${SLURM_CPUS_ON_NODE:-$(nproc)}
export OMP_PROC_BIND=close
export OMP_PLACES=cores
SIZE=${SIZE:-8000}

echo "threads,T,runtime_s (${SIZE}x${SIZE}x100)"
t=1
while [ $t -le $NCPUS ]; do
  for T in 16 32 64; do
    r=$(OMP_NUM_THREADS=$t STENCIL_T=$T \
          ./stencil $SIZE $SIZE 100 2>/dev/null | awk '/runtime/ {print $2}')
    echo "$t,$T,$r"
  done
  if [ $t -lt $NCPUS ] && [ $((t * 2)) -gt $NCPUS ]; then t=$NCPUS; else t=$((t * 2)); fi
done
