#!/bin/bash
# Étude de passage à l'échelle (strong scaling) OpenMP sur ROMEO.
# Soumission :   sbatch scaling.job        (résultats dans scaling.out)
# Ne pas lancer en même temps que stencil.job (les deux font make clean) :
#   sbatch --dependency=afterany:<id_stencil> scaling.job

#SBATCH --nodes 1
#SBATCH --ntasks-per-node 1
#SBATCH --job-name stencil-scaling
#SBATCH --time 00:30:00
#SBATCH --output scaling.out
#SBATCH --exclusive
#SBATCH --mem 64G
#SBATCH --partition instant
#SBATCH --account r250127
#SBATCH --constraint x64cpu

. /apps/2025/manual_install/spack-x64cpu-1.0.x/share/spack/setup-env.sh
spack load gcc@14.2.0

set -e
make clean >/dev/null
make stencil

NCPUS=${SLURM_CPUS_ON_NODE:-$(nproc)}
export OMP_PROC_BIND=close
export OMP_PLACES=cores
SIZE=${SIZE:-8000}

echo "threads,T,runtime_s (${SIZE}x${SIZE}x100, T=auto : réglage par défaut)"
for t in 1 2 4 8 16 32 64 96 128 192 256 384; do
  [ $t -gt $NCPUS ] && continue
  for T in auto 16 32; do
    if [ $T = auto ]; then unset STENCIL_T; else export STENCIL_T=$T; fi
    r=$(OMP_NUM_THREADS=$t ./stencil $SIZE $SIZE 100 2>cfg.txt | awk '/runtime/ {print $2}')
    echo "$t,$T,$r,$(cat cfg.txt)"
  done
done
rm -f cfg.txt
